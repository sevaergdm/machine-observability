[Unit]
Description=Machine observability agent
Documentation=https://github.com/sevaergdm/machine-observability

[Service]
Type=simple
User=machineobs
ExecStart=/usr/bin/machine-observability -config /etc/machine-observability/config.toml
Restart=on-failure
RestartSec=5s

StateDirectory=machine-observability
StateDirectoryMode=0750

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

CapabilityBoundingSet=
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
ProtectProc=invisible
PrivateDevices=true
PrivateNetwork=true
RemoveIPC=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0027

[Install]
WantedBy=multi-user.target
